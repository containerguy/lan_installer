[Unit]
Description=LANReady management containers
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/lanready-cache

[Service]
Type=oneshot
RemainAfterExit=yes
User=ubuntu
Environment=HOME=/home/ubuntu
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DOCKER_HOST=unix:///run/user/1000/docker.sock
WorkingDirectory=/home/ubuntu/lanready
ExecStartPre=/usr/bin/mountpoint -q /mnt/lanready-cache
ExecStart=/usr/bin/docker compose -f compose.yaml -f compose.npm.yaml up -d --force-recreate --remove-orphans
ExecStop=/usr/bin/docker compose -f compose.yaml -f compose.npm.yaml stop
Restart=on-failure
RestartSec=10s
TimeoutStartSec=10min
TimeoutStopSec=2min

[Install]
WantedBy=multi-user.target
