{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-manager.familie-keller.info/schemas/v2/event-release-envelope.schema.json",
  "title": "LANReady EventRelease envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "keyId",
    "algorithm",
    "payload",
    "signature"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "keyId": {
      "type": "string",
      "pattern": "^ed25519-[0-9a-f]{16}$"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "payload": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 4194304
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "size",
        "mediaType",
        "fileName"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 127
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\]+$"
        }
      }
    },
    "action": {
      "oneOf": [
        {
          "title": "Launcher erkennen",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter",
            "operation"
          ],
          "properties": {
            "adapter": {
              "enum": [
                "steam",
                "ea_app",
                "ubisoft_connect"
              ]
            },
            "operation": {
              "const": "detect"
            }
          }
        },
        {
          "title": "Launcher installieren",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter",
            "operation",
            "artifactDigest"
          ],
          "properties": {
            "adapter": {
              "enum": [
                "steam",
                "ea_app",
                "ubisoft_connect"
              ]
            },
            "operation": {
              "const": "install_launcher"
            },
            "artifactDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "arguments": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 512
              }
            }
          }
        },
        {
          "title": "Launcher-Bibliothek importieren",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter",
            "operation",
            "artifactDigest",
            "targetRoot",
            "relativePath"
          ],
          "properties": {
            "adapter": {
              "enum": [
                "steam",
                "ea_app",
                "ubisoft_connect"
              ]
            },
            "operation": {
              "const": "import_library"
            },
            "artifactDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "targetRoot": {
              "enum": [
                "steam_library",
                "ea_library",
                "ubisoft_library"
              ]
            },
            "relativePath": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        {
          "title": "Archiv extrahieren",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter",
            "operation",
            "artifactDigest",
            "targetRoot",
            "relativePath"
          ],
          "properties": {
            "adapter": {
              "const": "lanready_archive"
            },
            "operation": {
              "const": "extract_archive"
            },
            "artifactDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "targetRoot": {
              "enum": [
                "user_games",
                "steam_library",
                "ea_library",
                "ubisoft_library",
                "temp"
              ]
            },
            "relativePath": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        {
          "title": "Verzeichnisbaum materialisieren",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter",
            "operation",
            "artifactDigest",
            "targetRoot",
            "relativePath"
          ],
          "properties": {
            "adapter": {
              "const": "lanready_tree"
            },
            "operation": {
              "const": "materialize_tree"
            },
            "artifactDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "targetRoot": {
              "enum": [
                "user_games",
                "steam_library",
                "ea_library",
                "ubisoft_library"
              ]
            },
            "relativePath": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        {
          "title": "Artefakt prüfen",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter",
            "operation",
            "artifactDigest"
          ],
          "properties": {
            "adapter": {
              "enum": [
                "steam",
                "ea_app",
                "ubisoft_connect",
                "lanready_archive",
                "lanready_tree"
              ]
            },
            "operation": {
              "const": "verify"
            },
            "artifactDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "launcherRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launcherId",
        "version",
        "required",
        "actions"
      ],
      "properties": {
        "launcherId": {
          "enum": [
            "steam",
            "ea-app",
            "ubisoft-connect"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "required": {
          "type": "boolean"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "artifacts",
        "actions"
      ],
      "properties": {
        "type": {
          "enum": [
            "launcher_library",
            "archive",
            "directory_tree",
            "installer"
          ]
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "gameRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gameId",
        "name",
        "launcherId",
        "version",
        "required",
        "payloads"
      ],
      "properties": {
        "gameId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "launcherId": {
          "enum": [
            "steam",
            "ea-app",
            "ubisoft-connect",
            "standalone"
          ]
        },
        "externalGameId": {
          "type": "string",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "required": {
          "type": "boolean"
        },
        "payloads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/payload"
          }
        }
      }
    },
    "eventRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "eventId",
        "releaseId",
        "sequence",
        "issuedAt",
        "validUntil",
        "minimumClientVersion",
        "artifacts",
        "launchers",
        "games"
      ],
      "properties": {
        "formatVersion": {
          "const": 2
        },
        "eventId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "releaseId": {
          "type": "string",
          "minLength": 20,
          "maxLength": 64
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "validUntil": {
          "type": "string",
          "format": "date-time"
        },
        "minimumClientVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "artifacts": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "launchers": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/launcherRelease"
          }
        },
        "games": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/gameRelease"
          }
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^/\\\\][^\\r\\n]*$"
    }
  }
}
