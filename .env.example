# Copy this file to .env and replace both tokens. Keep .env private.
LANREADY_CLIENT_TOKEN=replace-with-a-long-random-client-token
LANREADY_ADMIN_TOKEN=replace-with-a-different-long-random-admin-token

# 0.0.0.0 makes the API reachable from the LAN. Use 127.0.0.1 behind
# a reverse proxy on an internet-facing host.
LANREADY_BIND_ADDRESS=0.0.0.0
LANREADY_PORT=8080
LANREADY_MIRROR_PORT=8081

# Linux host UID/GID that owns ./data. `id -u` and `id -g` show the values.
# Docker Desktop users normally keep these defaults.
LANREADY_UID=1000
LANREADY_GID=1000
LANREADY_VERSION=dev

# Der Container verwendet immer /cache. Bis ein NAS-Verzeichnis eingebunden ist,
# dient ./data/cache als lokaler Fallback. Nach dem Mount nur diesen Hostpfad ändern.
LANREADY_CACHE_HOST_PATH=./data/cache
# Konservative Übergangsquota für die aktuell gemessene Root-Disk (10 GiB bei rund
# 20 GiB freiem Speicher). Nach NAS-Anbindung ausdrücklich anpassen.
LANREADY_CACHE_QUOTA_BYTES=10737418240
# Für produktive Netzwerk-Mounts zwingend auf den exakten Inhalt der regulären
# Datei <LANREADY_CACHE_HOST_PATH>/.lanready-cache-volume setzen. Fehlt der Mount
# oder stimmt die ID nicht, beendet sich der Server fail-closed vor Cachezugriffen.
LANREADY_CACHE_VOLUME_ID=

# Existing Docker network used by Nginx Proxy Manager.
LANREADY_PROXY_NETWORK=nginx-proxy-manager_default

# Initialer lokaler Web-Admin. Das Passwort liegt absichtlich in einer separaten,
# nicht eingecheckten Docker-Secret-Datei.
LANREADY_WEB_ADMIN_USER=admin
LANREADY_WEB_ADMIN_PASSWORD_FILE=./secrets/web-admin-password.txt
LANREADY_SECURE_COOKIES=true
LANREADY_PUBLIC_URL=https://game-manager.example.org
# Ausschließlich das tatsächliche Docker-Netz des Reverse Proxys eintragen.
# Mit `docker network inspect <netz>` prüfen; nicht pauschal das gesamte LAN vertrauen.
LANREADY_TRUSTED_PROXY_CIDRS=172.20.0.0/16
LANREADY_WEBDAV_MASTER_KEY_FILE=./secrets/webdav-master-key.txt
# Öffentlicher Ed25519-Release-Key. Der zugehörige Private Key bleibt ausschließlich
# unter ./release-work und wird niemals in den Servercontainer gemountet.
LANREADY_RELEASE_PUBLIC_KEY_FILE=./secrets/release-public.key
# SHA-256-Fingerprint (64 lowercase Hexzeichen) des DER-codierten öffentlichen
# Authenticode-Herausgeberzertifikats. Ohne Wert bleiben Clientupdates fail-closed
# unveröffentlichbar; Event-Releases funktionieren weiterhin.
LANREADY_AUTHENTICODE_PUBLISHER_SHA256=

# Standardmäßig sind private, Loopback- und Link-Local-Ziele gesperrt. Nur wenn eine
# interne HTTPS-Quelle benötigt wird: exakter Host mit erlaubten Ziel-CIDRs; mehrere
# Hosts werden durch Semikolon, CIDRs durch Komma getrennt. Keine URL oder Credentials.
# LANREADY_SOURCE_PRIVATE_ALLOWLIST=cloud.lan=192.168.220.0/24;nas.lan=10.20.0.0/16
